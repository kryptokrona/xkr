 	return result;
 }
 
+// Kryptokrona addresses carry no network, so s_networkType is always Mainnet and the fork
+// heights cannot depend on it. The daemon's get_info "testnet" flag decides instead: only a
+// testnet daemon lets the environment override the compiled-in heights, like the kryptokronad
+// testnet patch (XKR_FORK13_HEIGHT). Every p2pool node of a sidechain and its daemon must use
+// the same heights, otherwise shares are rejected by the major version check of the parser.
+static uint64_t xkr_fork_height_from_env(const char* name, uint64_t compiled, bool daemon_testnet)
+{
+	const char* env = std::getenv(name);
+	if (!env || !*env) {
+		return compiled;
+	}
+
+	if (!daemon_testnet) {
+		LOGWARN(1, name << " is set but the daemon is not on testnet, ignoring it (using " << compiled << ")");
+		return compiled;
+	}
+
+	char* end = nullptr;
+	const uint64_t h = std::strtoull(env, &end, 10);
+	if (!end || *end) {
+		LOGERR(1, name << " = \"" << env << "\" is not a block height, ignoring it (using " << compiled << ")");
+		return compiled;
+	}
+
+	return h;
+}
+
+void SideChain::configure_forks(bool daemon_testnet)
+{
+	s_fork13Height = xkr_fork_height_from_env("XKR_FORK13_HEIGHT", coin::FORK13_HEIGHT_DEFAULT, daemon_testnet);
+
+	LOGINFO(1, "XKR fork 13 (block major version " << static_cast<uint32_t>(coin::FORK13_MAJOR_VERSION) << ") at height " << s_fork13Height << (s_fork13Height ? "" : " (not scheduled)") <<
+		", signalling fork index " << static_cast<uint32_t>(coin::SUPPORTED_FORK_INDEX));
+}
