 	for (size_t i = 1; (i < num_hard_forks) && (height >= hard_forks[i].height); ++i) {
 		result = hard_forks[i].version;
 	}
+
+	// XKR fork 13 (not in the hardforks tables because its height is set at run time on the
+	// testnet): block major version 6 from block F + 1 on.
+	if (s_fork13Height && (height > s_fork13Height) && (result < coin::FORK13_MAJOR_VERSION)) {
