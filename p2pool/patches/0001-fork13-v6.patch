@@ -98,6 +98,25 @@
 // there is a single aux chain (the block itself), no branch.
 static constexpr uint8_t  PARENT_MM_TAG_DEPTH = 0;
 
+// Fork schedule after the C++ v1.2.2 table (xkrd: xkr-consensus::forks, docs/forks.md in the
+// xkr repository). A fork at height F governs blocks F + 1, F + 2, ...; block F is the last
+// block under the old rules (UpgradeManager: upgrade height < block index). 0 = not scheduled.
+// Build with -DXKR_FORK13_HEIGHT=<h> for a release with a fixed height; a daemon that reports
+// "testnet" lets the environment variable XKR_FORK13_HEIGHT override it at start-up
+// (SideChain::configure_forks), mirroring the kryptokronad testnet patch.
+//   fork 13: block major version 6; block format, coinbase, PoW, difficulty and reward of v5.
+#ifndef XKR_FORK13_HEIGHT
+#define XKR_FORK13_HEIGHT 2700000
+#endif
+static constexpr uint64_t FORK13_HEIGHT_DEFAULT = XKR_FORK13_HEIGHT;
+static constexpr uint8_t  FORK13_MAJOR_VERSION  = 6;
+
+// Highest fork index this build supports. Written as the block minor version so that
+// xkrd's /getinfo.fork_readiness counts p2pool blocks (a block signals fork t if
+// minor >= t and minor != 16; Monero's HARDFORK_SUPPORTED_VERSION 16 counts as no signal).
+// Neither kryptokronad, xkrd nor p2pool validates the minor version.
+static constexpr uint8_t  SUPPORTED_FORK_INDEX  = 13;
+
 // Default kryptokrona daemon RPC port that p2pool talks to via JSON-RPC.
 // Kryptokrona: mainnet RPC 11898, testnet RPC 11899 (P2P is 11897 / 11898).
 #ifdef USE_TESTNET
