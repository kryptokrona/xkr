+#endif
+static constexpr uint64_t FORK14_HEIGHT_DEFAULT = XKR_FORK14_HEIGHT;
+static constexpr uint8_t  FORK14_MAJOR_VERSION  = 7;
+static constexpr uint8_t  COINBASE_TX_VERSION_2 = 2;
+
+// Coinbase transaction version of a block with this major version.
+static constexpr uint8_t coinbase_tx_version(uint64_t major_version)
