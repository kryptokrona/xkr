{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xkr-desktop-sample",
  "version": "0.1.0",
  "identifier": "org.kryptokrona.xkr.desktop-sample",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "xkr node",
        "width": 760,
        "height": 720,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "externalBin": ["binaries/xkrd"],
    "resources": {
      "resources/bridge/": "bridge/",
      "resources/lib/": "lib/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist"
    }
  }
}
